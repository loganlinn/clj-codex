{:paths ["src" "resources" "apis"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        cheshire/cheshire {:mvn/version "5.13.0"}
        babashka/process {:mvn/version "0.6.23"}
        org.babashka/http-client {:mvn/version "0.4.22"}}
 :aliases {:build {:extra-paths ["script"]
                   :deps {cheshire/cheshire {:mvn/version "5.13.0"}
                          io.github.clojure/tools.build {:mvn/version "0.10.14"}
                          slipset/deps-deploy {:mvn/version "0.2.5"}}
                   :ns-default build}
           :test {:extra-paths ["test"]
                  :extra-deps {http-kit/http-kit {:mvn/version "2.6.0"}}
                  :main-opts ["-m" "codex.test-runner"]}}}
