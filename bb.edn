{:paths ["src" "resources" "apis" "test"]

 :tasks
 {:init (defn build-task [task]
          (when (> (count *command-line-args*) 1)
            (throw (ex-info "Expected one release tag or snapshot version" {})))
          (apply clojure "-T:build" task
                 (when-let [version (first *command-line-args*)]
                   [(if (.startsWith version "v") ":tag" ":version") (pr-str version)])))

  clean {:doc "Delete build output"
         :task (clojure "-T:build" "clean")}

  jar {:doc "Build a JAR and POM: bb jar v0.1.0 or bb jar 0.1.0-SNAPSHOT"
       :task (build-task "jar")}

  install {:doc "Install locally: bb install v0.1.0 or bb install 0.1.0-SNAPSHOT"
           :task (build-task "install")}

  release:check {:doc "Check the release tag, commit, and clean checkout: bb release:check v0.1.0"
                 :task (build-task "check-release")}

  release:draft {:doc "Check CI and version availability, push a tag, and create a GitHub draft: bb release:draft v0.1.0"
                 :extra-paths ["script"]
                 :task (apply (requiring-resolve 'release/-main) *command-line-args*)}

  publish {:doc "Build and publish a tagged release to Clojars: bb publish v0.1.0"
           :task (build-task "publish")}

  snapshot:check {:doc "Check a snapshot version and clean checkout: bb snapshot:check 0.1.0-SNAPSHOT"
                  :task (build-task "check-snapshot")}

  publish:snapshot {:doc "Publish without a Git tag: bb publish:snapshot 0.1.0-SNAPSHOT"
                    :task (build-task "publish-snapshot")}

  test:build {:doc "Check publication versions, guards, and package contents without uploading"
              :task (clojure "-T:build" "test-build")}

  test:release {:doc "Check draft release guards and orchestration without GitHub or Clojars writes"
                :extra-paths ["script"]
                :task ((requiring-resolve 'release-test/-main))}

  test {:doc "Run the shared test suite in Babashka"
        :task (apply (requiring-resolve 'codex.test-runner/-main) *command-line-args*)}

  test:jvm {:doc "Run the shared test suite in JVM Clojure"
            :task (apply clojure "-M:test" *command-line-args*)}

  test:unix-live {:doc "Run an isolated live Codex Unix socket smoke test"
                  :task (apply (requiring-resolve 'codex.unix-smoke/-main) *command-line-args*)}

  codegen {:doc "Regenerate protocol schemas and catalog using the pinned Codex version"
           :extra-paths ["script"]
           :task ((requiring-resolve 'codegen/-main))}

  codegen:check {:doc "Regenerate in a temporary directory and check all committed outputs"
                 :extra-paths ["script"]
                 :task ((requiring-resolve 'codegen/-main) "--check")}

  schemas:check {:doc "Check bundled schema provenance and references without Codex"
                 :extra-paths ["script"]
                 :task (do ((requiring-resolve 'schema-bundle/check!) ".")
                           (println "Schema bundle integrity checks passed."))}

  test:codegen {:doc "Check schema drift detection, replacement, and integrity guards"
                :extra-paths ["script"]
                :task ((requiring-resolve 'codegen-test/-main))}

  fmt {:doc "Fix Clojure formatting (optional file or directory arguments)"
       :extra-deps {dev.weavejester/cljfmt {:mvn/version "0.16.5"}}
       :requires ([cljfmt.tool :as fmt])
       :task (fmt/fix (cond-> {}
                        (seq *command-line-args*) (assoc :paths *command-line-args*)))}

  fmt:check {:doc "Check Clojure formatting without changing files"
             :extra-deps {dev.weavejester/cljfmt {:mvn/version "0.16.5"}}
             :requires ([cljfmt.tool :as fmt])
             :task (fmt/check (cond-> {}
                                (seq *command-line-args*) (assoc :paths *command-line-args*)))}

  quickdoc {:doc "Generate API.md from public namespace docstrings"
            :extra-deps {io.github.borkdude/quickdoc {:git/tag "v0.2.6" :git/sha "ce8678000afa5f835639dd7267dc191fd90495a2"}}
            :requires ([babashka.cli :as cli]
                       [babashka.fs :as fs]
                       [quickdoc.api :as api])
            :task (api/quickdoc (merge {:git/branch "main"
                                        :github/repo "https://github.com/loganlinn/clj-codex"
                                        :source-paths (mapv str (sort (fs/glob "src/codex" "*.clj")))
                                        :outfile "API.md"
                                        :toc true
                                        :var-links true
                                        :var-pattern :wikilinks}
                                       (cli/parse-opts *command-line-args*
                                                       {:coerce {:toc :boolean
                                                                 :var-links :boolean}})))}}}
