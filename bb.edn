{:paths ["src" "resources" "apis" "test"]

 :tasks
 {test {:doc "Run the shared test suite in Babashka"
        :task (apply (requiring-resolve 'codex.test-runner/-main) *command-line-args*)}

  test:jvm {:doc "Run the shared test suite in JVM Clojure"
            :task (apply clojure "-M:test" *command-line-args*)}

  test:unix-live {:doc "Run an isolated live Codex Unix socket smoke test"
                  :task (apply (requiring-resolve 'codex.unix-smoke/-main) *command-line-args*)}

  codegen {:doc "Regenerate protocol schemas and catalog using installed Codex"
           :task (shell "bb --classpath src script/codegen.clj")}

  fmt {:doc "Fix Clojure formatting (optional file or directory arguments)"
       :extra-deps {dev.weavejester/cljfmt {:mvn/version "0.16.5"}}
       :requires ([cljfmt.tool :as fmt])
       :task (fmt/fix (cond-> {}
                        (seq *command-line-args*) (assoc :paths *command-line-args*)))}

  fmt:check {:doc "Check Clojure formatting without changing files"
             :extra-deps {dev.weavejester/cljfmt {:mvn/version "0.16.5"}}
             :requires ([cljfmt.tool :as fmt])
             :task (fmt/check (cond-> {}
                                (seq *command-line-args*) (assoc :paths *command-line-args*)))}

  quickdoc {:doc "Generate API.md from public namespace docstrings"
            :extra-deps {io.github.borkdude/quickdoc {:git/tag "v0.2.6" :git/sha "ce8678000afa5f835639dd7267dc191fd90495a2"}}
            :requires ([babashka.cli :as cli]
                       [babashka.fs :as fs]
                       [quickdoc.api :as api])
            :task (api/quickdoc (merge {:git/branch "main"
                                        :github/repo "https://github.com/loganlinn/clj-codex"
                                        :source-paths (mapv str (sort (fs/glob "src/codex" "*.clj")))
                                        :outfile "API.md"
                                        :toc true
                                        :var-links true
                                        :var-pattern :wikilinks}
                                       (cli/parse-opts *command-line-args*
                                                       {:coerce {:toc :boolean
                                                                 :var-links :boolean}})))}}}
